#!/bin/bash

set -euo pipefail

# Starts a Claude Code session for one merge request in a tmux session.
# A review session reviews the merge request and publishes the review.
# A fix session (--fix) works on the source branch with the threads and the failed jobs.
#
#   omasecretary-review open [--fix] <project> <iid>   Open the session in a terminal.
#   omasecretary-review open [--fix] <url>             The same, from a merge request link.
#   omasecretary-review run [--fix] <project> <iid>    Prepare the checkout and start Claude Code.
#                                                      The tmux session uses this command.
#   omasecretary-review prune                          Remove the data of merged and closed merge requests.

self=$(readlink -f -- "${BASH_SOURCE[0]}")
root=$(dirname -- "$(dirname -- "$self")")
state="${XDG_STATE_HOME:-$HOME/.local/state}/omasecretary"
reviews="$state/reviews.json"

fail() {
  printf 'omasecretary-review: %s\n' "$1" >&2
  exit 1
}

check_target() {
  [[ $1 =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)+$ ]] || fail "invalid project: $1"
  [[ $2 =~ ^[1-9][0-9]*$ ]] || fail "invalid merge request number: $2"
}

api_path() {
  printf 'projects/%s/merge_requests/%s' "${1//\//%2F}" "$2"
}

# The key of the session kind in reviews.json.
section_of() {
  if [[ $1 == fix ]]; then printf 'fixes'; else printf 'reviews'; fi
}

# tmux does not accept "." and ":" in a session name.
session_name() {
  local prefix=mr
  [[ $1 == fix ]] && prefix=fix
  local name="$prefix-${2##*/}-$3"
  printf '%s' "${name//[^A-Za-z0-9_-]/_}"
}

# Changes reviews.json with a jq filter. The lock keeps two sessions that start
# at the same time from losing an entry.
update_reviews() {
  mkdir -p "$state"
  (
    flock 9
    [[ -s $reviews ]] || printf '{"version":1,"reviews":{}}\n' >"$reviews"
    jq "$@" "$reviews" >"$reviews.tmp"
    mv "$reviews.tmp" "$reviews"
  ) 9>"$state/reviews.lock"
}

review_field() {
  jq -r --arg section "$1" --arg key "$2" --arg field "$3" '.[$section][$key][$field] // ""' "$reviews" 2>/dev/null || true
}

# Prints the clone to use: a clone in $OMASECRETARY_PROJECTS whose origin is the
# project, or a clone that the plugin keeps in its state folder.
repo_for() {
  local project=$1 web=$2 host dir origin
  host=${web#https://}
  host=${host%%/*}

  if [[ -n ${OMASECRETARY_PROJECTS:-} ]]; then
    for dir in "$OMASECRETARY_PROJECTS"/*/; do
      origin=$(git -C "$dir" config --get remote.origin.url 2>/dev/null) || continue
      origin=${origin%.git}
      if [[ $origin == "https://$host/$project" || $origin == "git@$host:$project" || $origin == "ssh://git@$host/$project" ]]; then
        printf '%s\n' "${dir%/}"
        return
      fi
    done
  fi

  dir="$state/repos/$project"
  if [[ ! -d $dir ]]; then
    printf 'Cloning %s…\n' "$project" >&2
    git clone --quiet "https://$host/$project.git" "$dir" >&2
  fi
  printf '%s\n' "$dir"
}

# The replacements are in quotes. Without them, bash 5.2 replaces "&" in a value
# with the placeholder.
prompt() {
  local text
  text=$(<"$root/prompts/$1.md")
  text=${text//'{{project}}'/"$project"}
  text=${text//'{{iid}}'/"$iid"}
  text=${text//'{{url}}'/"$url"}
  text=${text//'{{api}}'/"$api"}
  text=${text//'{{target}}'/"$target"}
  text=${text//'{{source}}'/"$source"}
  text=${text//'{{sha}}'/"$sha"}
  text=${text//'{{previous}}'/"$previous"}
  printf '%s' "$text"
}

open_session() {
  local kind=review project iid key name marker
  if [[ ${1:-} == --fix ]]; then
    kind=fix
    shift
  fi
  if [[ $# -eq 1 && $1 =~ ^https://[^/]+/(.+)/-/merge_requests/([0-9]+) ]]; then
    project=${BASH_REMATCH[1]}
    iid=${BASH_REMATCH[2]}
  elif [[ $# -eq 2 ]]; then
    project=$1
    iid=$2
  else
    fail "usage: omasecretary-review open [--fix] <project> <iid> | <url>"
  fi
  check_target "$project" "$iid"
  key="$kind:$project!$iid"
  name=$(session_name "$kind" "$project" "$iid")

  if tmux has-session -t "=$name" 2>/dev/null; then
    marker=$(tmux show-options -t "=$name:" -qv @omasecretary 2>/dev/null || true)
    if [[ -z $marker ]]; then
      # tmux-resurrect restores a session as a plain shell without the marker.
      tmux kill-session -t "=$name"
    elif [[ $marker != "$key" ]]; then
      fail "the tmux session $name belongs to $marker"
    fi
  fi

  if ! tmux has-session -t "=$name" 2>/dev/null; then
    local args=("$project" "$iid")
    [[ $kind == fix ]] && args=(--fix "${args[@]}")
    # A new login shell gives Claude Code the environment of a terminal and not
    # the environment of the tmux server, which can be older or from another profile.
    tmux new-session -d -s "$name" -c "$HOME" -- \
      env -u CLAUDE_CONFIG_DIR bash -lc 'exec "$0" run "$@"' "$self" "${args[@]}"
    tmux set-option -t "=$name:" @omasecretary "$key"
  fi

  omarchy-launch-terminal tmux attach-session -t "=$name"
}

run_session() {
  local kind=$1 project=$2 iid=$3 section key api mr state_now url target source repo sha previous id worktree config
  check_target "$project" "$iid"
  section=$(section_of "$kind")
  key="$project!$iid"
  api=$(api_path "$project" "$iid")

  # Errors stay on the screen. Without this, the tmux session closes at once.
  trap 'status=$?; if (( status != 0 )); then printf "\nThe session did not start. Press Enter to close.\n"; read -r _ || true; fi' EXIT

  printf 'Reading %s…\n' "$key"
  mr=$(glab api "$api")
  state_now=$(jq -r '.state' <<<"$mr")
  url=$(jq -r '.web_url' <<<"$mr")
  target=$(jq -r '.target_branch' <<<"$mr")
  source=$(jq -r '.source_branch' <<<"$mr")
  [[ $state_now == opened ]] || fail "the merge request is $state_now"
  [[ $url == https://*/-/merge_requests/* ]] || fail "GitLab returned no link for $key"
  if [[ $kind == fix && $(jq -r '.source_project_id == .target_project_id' <<<"$mr") != true ]]; then
    fail "a fix session does not support a merge request from a fork"
  fi

  worktree="$state/worktrees/${project//\//--}--$iid"
  [[ $kind == fix ]] && worktree+="--fix"
  if [[ -e $worktree/.git ]]; then
    repo=$worktree
  else
    repo=$(repo_for "$project" "$url")
  fi
  printf 'Fetching the merge request into %s…\n' "$repo"
  git -C "$repo" fetch --quiet origin "$target"
  if [[ $kind == fix ]]; then
    git -C "$repo" fetch --quiet origin "$source"
  else
    git -C "$repo" fetch --quiet origin "merge-requests/$iid/head"
  fi
  sha=$(git -C "$repo" rev-parse FETCH_HEAD)

  if [[ $repo != "$worktree" ]]; then
    mkdir -p "$state/worktrees"
    # --force also accepts a path that git still lists after the folder was removed.
    git -C "$repo" worktree add --quiet --force --detach "$worktree" "$sha"
  elif [[ $kind == review ]]; then
    git -C "$worktree" checkout --quiet --detach --force "$sha"
  elif [[ -z $(git -C "$worktree" status --porcelain --untracked-files=no) ]] &&
    git -C "$worktree" merge-base --is-ancestor HEAD "$sha"; then
    git -C "$worktree" checkout --quiet --detach "$sha"
  else
    # An earlier fix session left commits or changes that are not on the branch.
    printf 'The worktree keeps its local work at %s.\n' "$(git -C "$worktree" rev-parse --short HEAD)"
  fi

  previous=$(review_field "$section" "$key" sha)
  id=$(review_field "$section" "$key" sessionId)
  [[ -n $id ]] || id=$(uuidgen)
  update_reviews --arg section "$section" --arg key "$key" --arg id "$id" --arg sha "$sha" --arg worktree "$worktree" \
    '.[$section][$key] = {sessionId: $id, sha: $sha, worktree: $worktree}'

  local first=review later=follow-up
  if [[ $kind == fix ]]; then
    first=fix
    later=fix
  fi

  cd "$worktree"
  # Claude Code keeps one transcript file for each session, and it removes old
  # transcripts. Without the transcript, the session starts again with the same ID.
  config=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
  if compgen -G "$config/projects/*/$id.jsonl" >/dev/null; then
    exec claude --permission-mode auto --effort xhigh --resume "$id" "$(prompt "$later")"
  fi
  exec claude --permission-mode auto --effort xhigh --session-id "$id" "$(prompt "$first")"
}

prune() {
  local section kind key worktree project iid mr_state common
  [[ -s $reviews ]] || return 0

  while IFS=$'\t' read -r section key worktree <&3; do
    kind=review
    [[ $section == fixes ]] && kind=fix
    project=${key%!*}
    iid=${key##*!}
    # An open tmux session can be in use.
    tmux has-session -t "=$(session_name "$kind" "$project" "$iid")" 2>/dev/null && continue
    mr_state=$(glab api "$(api_path "$project" "$iid")" 2>/dev/null | jq -r '.state // ""') || continue
    [[ $mr_state == merged || $mr_state == closed ]] || continue

    if [[ $worktree == "$state/worktrees/"* && -e $worktree/.git ]]; then
      common=$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir)
      git --git-dir="$common" worktree remove --force "$worktree"
    fi
    update_reviews --arg section "$section" --arg key "$key" 'del(.[$section][$key])'
  done 3< <(jq -r '("reviews", "fixes") as $section | .[$section] // {} | to_entries[] | [$section, .key, .value.worktree] | @tsv' "$reviews")
}

case "${1:-}" in
open)
  shift
  open_session "$@"
  ;;
run)
  if [[ $# -eq 4 && $2 == --fix ]]; then
    run_session fix "$3" "$4"
  elif [[ $# -eq 3 ]]; then
    run_session review "$2" "$3"
  else
    fail "usage: omasecretary-review run [--fix] <project> <iid>"
  fi
  ;;
prune)
  prune
  ;;
*)
  fail "usage: omasecretary-review open|run|prune"
  ;;
esac
