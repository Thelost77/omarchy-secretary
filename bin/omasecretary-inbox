#!/bin/bash

set -euo pipefail

# Prints one JSON document with the open merge requests that the user wrote or
# reviews, and the comment threads of each one. The helper only reads from GitLab.

readonly jobs=8
readonly max_seconds=30

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/threads"

read -r -d '' query <<'GRAPHQL' || true
query($endCursor: String) {
  currentUser {
    username
    mergeRequests: FIELD(state: opened, first: 100, after: $endCursor) {
      pageInfo { hasNextPage endCursor }
      nodes {
        iid title webUrl draft diffHeadSha updatedAt detailedMergeStatus sourceBranch targetBranch
        project { fullPath }
        author { name }
        headPipeline { status }
        approvedBy { nodes { username } }
        reviewers { nodes { username mergeRequestInteraction { reviewState } } }
      }
    }
  }
}
GRAPHQL

fetch_list() {
  timeout "$max_seconds" glab api graphql --paginate -f query="${query/FIELD/$1}"
}

fetch_list authoredMergeRequests >"$tmp/author.json"
fetch_list reviewRequestedMergeRequests >"$tmp/reviewer.json"

# A merge request that is in the two lists keeps the author role.
jq -n --slurpfile author "$tmp/author.json" --slurpfile reviewer "$tmp/reviewer.json" '
  def pages: if length == 0 or any(.[]; has("errors")) then error("GitLab rejected the query") else . end;
  def merge_requests($role): [.[].data.currentUser.mergeRequests.nodes[] | {
    key: "\(.project.fullPath)!\(.iid)",
    role: $role,
    project: .project.fullPath,
    iid: (.iid | tonumber),
    title,
    url: .webUrl,
    author: (.author.name // ""),
    draft,
    sha: (.diffHeadSha // ""),
    sourceBranch: (.sourceBranch // ""),
    targetBranch: (.targetBranch // ""),
    updatedAt,
    pipeline: (.headPipeline.status // "" | ascii_downcase),
    mergeStatus: (.detailedMergeStatus // "" | ascii_downcase),
    approvedBy: [.approvedBy.nodes[].username],
    reviewers: [.reviewers.nodes[] | {
      username,
      state: (.mergeRequestInteraction.reviewState // "" | ascii_downcase)
    }]
  }];
  ($author | pages) as $a | ($reviewer | pages) as $r | {
    version: 1,
    me: $a[0].data.currentUser.username,
    mergeRequests: (($a | merge_requests("author")) + ($r | merge_requests("reviewer")) | unique_by(.key))
  }
' >"$tmp/inbox.json"

# shellcheck disable=SC2016
jq -r '.mergeRequests[] | "\(.project | @uri) \(.iid)"' "$tmp/inbox.json" |
  xargs -r -P "$jobs" -L 1 bash -o pipefail -c '
    timeout "$1" glab api --paginate "projects/$2/merge_requests/$3/discussions?per_page=100" |
      jq -s -c --arg key "$2!$3" "{key: \$key, discussions: (add // [])}" >"$0/$2!$3.json"
  ' "$tmp/threads" "$max_seconds"

# A thread has only the notes that a person wrote. GitLab also keeps each system
# note, such as "added 2 commits", as a discussion. These notes are the events.
find "$tmp/threads" -name '*.json' -exec cat {} + | jq -s -c --slurpfile inbox "$tmp/inbox.json" '
  def thread: {
    resolved: ([.notes[] | select(.resolvable)] | length > 0 and all(.resolved)),
    notes: [.notes[] | select(.system | not) | {
      id,
      author: .author.username,
      at: .created_at,
      body: ((.body // "")[0:400]),
      path: (.position.new_path // .position.old_path // ""),
      line: (.position.new_line // .position.old_line // 0)
    }]
  };
  def events: [.discussions[].notes[] | select(.system) | {id, author: .author.username, at: .created_at, body: ((.body // "")[0:800])}];
  (map({key, value: [.discussions[] | thread | select(.notes | length > 0)]}) | from_entries) as $threads
  | (map({key, value: events}) | from_entries) as $events
  | $inbox[0]
  | .mergeRequests |= map(
      .threads = ($threads["\(.project | @uri)!\(.iid)"] // error("No threads for \(.key)"))
      | .events = $events["\(.project | @uri)!\(.iid)"]
    )
'
